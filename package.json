{
  "name": "gamehub",
  "version": "1.0.2",
  "description": "GameHub - Your gaming PC, organised.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.gamehub.app",
    "productName": "GameHub",
    "win": {
      "target": "nsis",
      "icon": "assets/branding/gamehub.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "finny-dev",
        "repo": "GameHub"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
